{
  "name": "zerog-motion",
  "version": "0.1.0",
  "description": "Weightless physics for modern web interfaces. < 2.5KB gzipped. Native WAAPI. Zero dependencies. Designed for modern frontends and AI code generators.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "require": "./dist/presets/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "keywords": [
    "animation",
    "waapi",
    "physics",
    "spring",
    "motion",
    "web-animations",
    "lightweight",
    "zero-dependency",
    "framer-motion-alternative"
  ],
  "author": "bytewhisker (https://github.com/bytewhisker)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytewhisker/zerog-motion.git"
  },
  "bugs": {
    "url": "https://github.com/bytewhisker/zerog-motion/issues"
  },
  "homepage": "https://github.com/bytewhisker/zerog-motion#readme",
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
